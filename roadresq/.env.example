# Local dev with `npm run dev` + backend on :5000. Either works:
#   absolute URL → talks to the backend directly (CORS_ORIGIN on the backend must allow :5173)
#   /api         → goes through the Vite dev proxy (vite.config.js), same-origin like production
VITE_API_URL=http://localhost:5000/api
# Docker build uses /api (Nginx proxies it). Vercel build: https://<your-render-app>.onrender.com/api
