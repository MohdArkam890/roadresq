PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/roadresq
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# Auth endpoints: max attempts per 15 min per IP (default 20). Raise it for repeated Newman runs.
# AUTH_RATE_LIMIT_MAX=20
# Used only by the test suite (optional — falls back to an in-memory MongoDB)
# MONGO_URI_TEST=mongodb://localhost:27017/roadresq_test
