{
  "info": {
    "name": "RoadResQ API",
    "description": "Experiment 7 \u2014 validating the RoadResQ RESTful API. Import this collection and RoadResQ.postman_environment.json, then run the whole collection (Runner) top to bottom. Every request carries test scripts; tokens and ids are saved automatically, and each run uses unique emails and coordinates so it can be re-run any number of times. Headless: `npm run test:api` (Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 \u00b7 Auth (Exp 6)",
      "item": [
        {
          "name": "Register customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// first request of every run: mint a fresh run id and unique coordinates,",
                  "// so emails never collide and this run's mechanic is always the closest match",
                  "const id = Date.now();",
                  "pm.collectionVariables.set('runId', id);",
                  "pm.collectionVariables.set('lat', (20 + (id % 5000) / 1000).toFixed(4));",
                  "pm.collectionVariables.set('lng', (70 + (id % 3000) / 1000).toFixed(4));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('envelope success=true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const d = pm.response.json().data;",
                  "pm.test('returns a JWT', () => pm.expect(d.token.split('.')).to.have.lengthOf(3));",
                  "pm.test('password is never returned', () => pm.expect(JSON.stringify(d)).to.not.include('password'));",
                  "pm.test('role is customer', () => pm.expect(d.user.role).to.eql('customer'));",
                  "pm.collectionVariables.set('customerToken', d.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Fernandes\",\n  \"email\": \"customer.{{runId}}@test.dev\",\n  \"password\": \"password123\",\n  \"phone\": \"+91 98765 43210\",\n  \"role\": \"customer\"\n}"
            }
          }
        },
        {
          "name": "Register mechanic",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('envelope success=true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "const d = pm.response.json().data;",
                  "pm.test('role is mechanic with specialty', () => { pm.expect(d.user.role).to.eql('mechanic'); pm.expect(d.user.specialty).to.eql('battery'); });",
                  "pm.collectionVariables.set('mechanicToken', d.token);",
                  "pm.collectionVariables.set('mechanicId', d.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikram Rao\",\n  \"email\": \"mechanic.{{runId}}@test.dev\",\n  \"password\": \"password123\",\n  \"role\": \"mechanic\",\n  \"specialty\": \"battery\"\n}"
            }
          }
        },
        {
          "name": "Register second customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('otherToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Other Driver\",\n  \"email\": \"other.{{runId}}@test.dev\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('envelope success=true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('returns a token', () => pm.expect(pm.response.json().data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('customerToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer.{{runId}}@test.dev\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns the logged-in user', () => pm.expect(pm.response.json().data.user.email).to.include(pm.collectionVariables.get('runId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "2 \u00b7 Mechanics & availability",
      "item": [
        {
          "name": "Mechanic goes online at a location",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('available with location saved', () => { const u = pm.response.json().data; pm.expect(u.available).to.eql(true); pm.expect(u.location.lat).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{mechanicToken}}"
              }
            ],
            "url": "{{baseUrl}}/mechanics/availability",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"available\": true,\n  \"location\": { \"lat\": {{lat}}, \"lng\": {{lng}} }\n}"
            }
          }
        },
        {
          "name": "Find nearby mechanics (ranked)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json().data;",
                  "pm.test('our mechanic is ranked first', () => pm.expect(list[0]._id).to.eql(pm.collectionVariables.get('mechanicId')));",
                  "pm.test('sorted by score, best first', () => { for (let i = 1; i < list.length; i++) pm.expect(list[i-1].score).to.be.at.least(list[i].score); });",
                  "pm.test('no private fields leaked', () => list.forEach(m => { pm.expect(m).to.not.have.property('email'); pm.expect(m).to.not.have.property('password'); }));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/mechanics/nearby?problemType=battery&lat={{lat}}&lng={{lng}}"
          }
        }
      ]
    },
