{
  "name": "roadresq-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RoadResQ API — REST + MongoDB + JWT auth + WebSockets",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "lint": "node scripts/lint.js",
    "seed": "node scripts/seed.js",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "test:api": "newman run postman/RoadResQ.postman_collection.json -e postman/RoadResQ.postman_environment.json --reporters cli"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "newman": "^6.2.3",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
